{
  "//": "Production service or published library. Copy to .vibecheck.json in the project root.",
  "preset": "strict",
  "maxRetries": 3,
  "conventions": {
    "mode": "auto",
    "sampleSize": 12
  },
  "questions": {
    "readability": { "threshold": 0.8 },
    "test_coverage_adequate": { "threshold": 0.8 }
  },
  "hardGates": {
    "failingTests": true,
    "committedSecret": true,
    "submissionMismatch": true
  }
}
