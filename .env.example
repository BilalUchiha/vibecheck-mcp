# Copy to `.env` and fill in. NEVER commit your real key (`.env` is gitignored).
#
# The server reads a `.env` from, in order: $VIBECHECK_ENV_FILE, the directory the
# MCP client launches the server in, then this package's own directory. Real
# environment variables always win, so a client `env` block overrides this file.
#
# Jev API key from https://console.typesafe.ai (API Keys section).
# The key is read from the environment only. It is never written to logs, never
# accepted from `.vibecheck.json`, never sent anywhere except api.typesafe.ai,
# and never committed.
TYPESAFE_API_KEY=

# Optional overrides.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# VIBECHECK_JUDGE=mock          # `mock` | `typesafe`  (defaults to `typesafe` when a key is set, else `mock`)
# VIBECHECK_MODEL=jev-latest
# VIBECHECK_LOG_LEVEL=info      # `silent` | `info` | `debug`
# VIBECHECK_ENV_FILE=path/to/.env
